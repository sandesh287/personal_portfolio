APP_NAME=Sandesh Portfolio API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandesh_portfolio
JWT_SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOAD_ROOT=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sandesh-portfolio
MAX_IMAGE_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=100
MAX_DOCUMENT_UPLOAD_SIZE_MB=20
GITHUB_USERNAME=
GITHUB_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
