APP_NAME=Sandesh Portfolio API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandesh_portfolio
JWT_SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=90
REFRESH_COOKIE_NAME=portfolio_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
UPLOAD_ROOT=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sandesh-portfolio
MAX_IMAGE_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=100
MAX_DOCUMENT_UPLOAD_SIZE_MB=20
CONTACT_RATE_LIMIT_SUBMISSIONS=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
CONTACT_DUPLICATE_WINDOW_MINUTES=30
CONTACT_MAX_LINKS=3
GITHUB_USERNAME=
GITHUB_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
