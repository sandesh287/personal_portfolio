{
  "name": "sandesh-portfolio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "format": "npm --workspace frontend run format"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
